.venv/
__pycache__/
*.pyc
target/
/spikes/*/venv-*/
/spikes/*/venv/
/spikes/*/models/
/spikes/*/*.wav
/tests/evidence/*.raw
face/assets/preview_states.png
*.onnx
*.gguf
*.nemo
/spikes/wakeword/samples/
/spikes/wakeword/sherpa-onnx-kws-*/
/spikes/layershell/target/
/spikes/layershell/evidence/*.png

# Die Stand-ins der T-1.5-Fixtures liegen unter <fixture>/face/target/debug/,
# weil der Verifizierer denselben Pfad wie im echten Repo erwartet. Die Regel
# "target/" oben haette sie stillschweigend nie ins Repo gelassen -- und
# meta.sh waere nach einem frischen Clone kaputt gewesen.
!/tests/fixtures/known-good/**/target/
!/tests/mutants/**/target/

# T-4.6: die vier Mutantenbaeume sind 6,5 MB und vollstaendig ableitbar --
# tests/mutants/T-4.6/erzeugen.sh stellt sie deterministisch aus dem
# Gut-Muster her, und seit meta.sh ihn aufruft ist sein Ergebnis die einzige
# Fassung, die gilt. Eingecheckt waeren sie die zweite, und welche von beiden
# gemessen wird, entschiede der Zufall. Eng gefasst auf genau diesen Task:
# erzeugen.sh selbst bleibt versioniert, andere Tasks bleiben unberuehrt.
/tests/mutants/T-4.6/*/

# T-9.2/T-9.3: dieselbe Lage wie bei T-4.6. Die Mutantenbaeume sind
# vollstaendig aus dem Gut-Muster ableitbar; tests/mutants/T-9.x/erzeugen.sh
# stellt sie deterministisch her, und meta.sh ruft ihn vor jeder Messung auf.
# Eine eingecheckte Kopie waere die zweite Fassung -- und welche von beiden
# gemessen wird, entschiede der Zufall. erzeugen.sh selbst bleibt versioniert.
/tests/mutants/T-9.2/*/
/tests/mutants/T-9.3/*/

# T-3.8: die STT-Gewichte, 665 MB. Eng gefasst auf genau dieses
# Verzeichnis -- ein breiterer Eintrag (models/ oder *.onnx) haette
# nach Fall 7 der Fehlerliste spaeter lautlos Fixtures gefressen.
# Geholt wird das Modell mit spikes/stt-referenz/modell_holen.sh.
spikes/stt-referenz/models/

# Erzeugte Pets bleiben lokal: Bilder eines echten Gesichts gehoeren nicht in
# ein oeffentliches Repo, und der Generator baut sie in Minuten neu. Dazu die
# Vorlagen unter face/assets/pics/.
#
# Das Muster trifft JEDES Unterverzeichnis, nicht die vier von heute: alle
# verfolgten Dateien liegen direkt in `face/assets/` (Ember-Sheet, Manifest,
# Schrift, Icon), jedes Unterverzeichnis ist erzeugt. Eine Liste von Namen
# waere beim naechsten Pet schon unvollstaendig -- und ein vergessener Name
# hiesse: ein Gesicht rutscht ins oeffentliche Repo.
face/assets/*/
