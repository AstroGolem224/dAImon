{
  "_kommentar": "Inhalt in ~/.claude/settings.json unter 'hooks' einfuegen. Ein und derselbe Befehl fuer alle Events - das Event-JSON auf stdin enthaelt hook_event_name, der Daemon sortiert. '|| true' sorgt dafuer, dass ein toter Daemon Claude Code niemals stoert.",

  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "curl -s -m 1 -X POST -H 'Content-Type: application/json' --data-binary @- http://127.0.0.1:8787/hook >/dev/null 2>&1 || true" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "curl -s -m 1 -X POST -H 'Content-Type: application/json' --data-binary @- http://127.0.0.1:8787/hook >/dev/null 2>&1 || true" } ] }
    ],
    "PreToolUse": [
      { "matcher": ".*", "hooks": [ { "type": "command", "command": "curl -s -m 1 -X POST -H 'Content-Type: application/json' --data-binary @- http://127.0.0.1:8787/hook >/dev/null 2>&1 || true" } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "curl -s -m 1 -X POST -H 'Content-Type: application/json' --data-binary @- http://127.0.0.1:8787/hook >/dev/null 2>&1 || true" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "curl -s -m 1 -X POST -H 'Content-Type: application/json' --data-binary @- http://127.0.0.1:8787/hook >/dev/null 2>&1 || true" } ] }
    ],
    "StopFailure": [
      { "hooks": [ { "type": "command", "command": "curl -s -m 1 -X POST -H 'Content-Type: application/json' --data-binary @- http://127.0.0.1:8787/hook >/dev/null 2>&1 || true" } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "curl -s -m 1 -X POST -H 'Content-Type: application/json' --data-binary @- http://127.0.0.1:8787/hook >/dev/null 2>&1 || true" } ] }
    ]
  },

  "_alternative_http_hook": {
    "_kommentar": "Falls deine Claude-Code-Version HTTP-Hooks unterstuetzt, spart das den curl-Umweg. Dann statt des command-Objekts oben:",
    "type": "http",
    "url": "http://127.0.0.1:8787/hook",
    "timeout": 2
  }
}
