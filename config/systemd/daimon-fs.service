[Unit]
# T-4.9 — der Dateisystem-Broker. Löst einmal auf und mutiert über den
# Deskriptor; siehe daimon/brokers/fs/broker.py.
Description=dAImon Dateisystem-Broker (openat2, RESOLVE_BENEATH)
PartOf=graphical-session.target
After=daimon-hub.service
Requires=daimon-hub.service

[Service]
Type=simple
WorkingDirectory=/home/itiger013/Dokumente/Github/dAImon
ExecStart=/home/itiger013/Dokumente/Github/dAImon/.venv/bin/python \
    -m daimon.brokers.fs.daemon \
    --socket %t/daimon/fs-broker.sock
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
PrivateDevices=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict

# ProtectHome=tmpfs statt read-only -- das löst den Widerspruch aus v1.0.
# `read-only` hätte bedeutet: der Dateisystem-Broker kann keine Datei
# schreiben, also nichts tun. `tmpfs` blendet $HOME komplett aus und legt
# eine leere Attrappe darüber; sichtbar wird ausschließlich, was unten in
# ReadWritePaths steht. Ein Pfad, der hier nicht steht, existiert für diesen
# Prozess nicht -- das ist eine schärfere Aussage als "darf nicht schreiben".
ProtectHome=tmpfs
ReadWritePaths=%t/daimon %h/.local/state/daimon
# Die Arbeitsverzeichnisse, in denen der Broker überhaupt etwas tun darf.
# Diese Liste ist die eigentliche Schranke, und sie ist absichtlich kurz.
# Wer sie verlängert, verlängert die Reichweite des Pets -- nicht seine
# Bequemlichkeit.
ReadWritePaths=%h/Dokumente %h/Downloads
# Der XDG-Trash, sonst kann T-4.8 kein Undo-Artefakt anlegen.
ReadWritePaths=%h/.local/share/Trash

# Doppelt gemoppelt, mit Absicht: ProtectHome=tmpfs blendet diese Pfade schon
# aus. Steht die Zeile trotzdem hier, fällt eine spätere Lockerung von
# ProtectHome nicht lautlos aus.
InaccessiblePaths=-%h/.ssh -%h/.gnupg -%h/.local/share/keyrings -%h/.pki

ProtectProc=invisible
ProcSubset=pid
PrivateTmp=yes
LimitCORE=0
UMask=0077
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @swap @reboot @module
# openat2 gehört zu @file-system und bleibt damit erlaubt; ein zusätzliches
# Verbot hier würde den Broker um seine einzige TOCTOU-freie Auflösung
# bringen.

[Install]
WantedBy=graphical-session.target
