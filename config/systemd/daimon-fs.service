[Unit]
# T-4.9 — der Dateisystem-Broker. Löst einmal auf und mutiert über den
# Deskriptor; siehe daimon/brokers/fs/broker.py.
Description=dAImon Dateisystem-Broker (openat2, RESOLVE_BENEATH)
PartOf=graphical-session.target
After=daimon-hub.service
Requires=daimon-hub.service

[Service]
Type=simple
WorkingDirectory=/home/itiger013/Dokumente/Github/dAImon
ExecStart=/home/itiger013/Dokumente/Github/dAImon/.venv/bin/python \
    -m daimon.brokers.fs.daemon \
    --socket %t/daimon/fs-broker.sock \
    --wurzel %h/Dokumente \
    --wurzel %h/Downloads
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
# Design 7.5, Grundzeile fuer alle Units ausser egress (Befund T-4.14 K1).
CapabilityBoundingSet=
PrivateDevices=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict

# --- DIE Zusage aus T-7.1 Akzeptanzpunkt 1 -------------------------------
# BEFUND vom 18.08.: diese Zeile war auskommentiert, und `ProtectSystem=strict`
# schuetzt /usr, nicht $HOME. Das Archiv liegt unter $XDG_DATA_HOME -- der
# Dateibroker konnte also hineinschreiben. Gemessen hat es der Verifizierer,
# indem er jede Unit einen Schreibversuch machen liess:
#
#     daimon-recorder.service  SCHRIEB      (richtig)
#     daimon-eyes.service      VERWEIGERT   (richtig)
#     daimon-fs.service        SCHRIEB      (falsch)
#
# Damit gab es zwei schreibende Dienste statt einem, und einer davon ist der
# modellgetriebene: wer den Broker erreicht, konnte die Aufzeichnung dessen
# aendern, was wahrgenommen wurde.
#
# Die Abwaegung darunter war richtig und ist es geblieben -- nur ihre
# Nebenwirkung aufs Archiv hat am 09.08. niemand nachverfolgt. Die Antwort
# stand da schon im eigenen Text: was schreibbar sein soll, kommt mit
# `BindPaths=` zurueck. Diese Liste ist inzwischen vollstaendig (vier
# Wurzeln, unten), also kostet die Zeile nichts mehr.
ProtectHome=tmpfs
# ProtectHome=tmpfs blendet $HOME komplett aus. Zwei Folgen, beide am 09.08.
# als 226/NAMESPACE gemessen:
#
# 1. Auch das venv verschwindet, aus dem ExecStart startet -- und mit ihm der
#    Interpreter, denn `.venv/bin/python` ist ein Symlink nach
#    ~/.local/share/uv/python/. Beides muss eingeblendet werden, das Repo
#    allein genügt nicht.
# 2. `ReadWritePaths=` auf einen Pfad unter $HOME schlägt fehl: der Pfad ist
#    zu diesem Zeitpunkt vom tmpfs verdeckt, es gibt ihn im Namespace nicht.
#    Was schreibbar sein soll, wird mit `BindPaths=` eingeblendet -- das
#    bringt das echte Verzeichnis mit, statt ein verstecktes zu suchen.
#
# Diese Liste ist die eigentliche Schranke des FS-Brokers, und sie ist
# absichtlich kurz. Wer sie verlängert, verlängert die Reichweite des Pets.
BindReadOnlyPaths=/home/itiger013/Dokumente/Github/dAImon
BindReadOnlyPaths=/home/itiger013/.local/share/uv/python
BindPaths=/home/itiger013/Dokumente
BindPaths=/home/itiger013/Downloads
BindPaths=/home/itiger013/.local/share/Trash
BindPaths=/home/itiger013/.local/state/daimon
RuntimeDirectory=daimon
RuntimeDirectoryPreserve=yes
ReadWritePaths=%t/daimon
InaccessiblePaths=-%h/.ssh -%h/.gnupg -%h/.local/share/keyrings -%h/.pki
PrivateTmp=yes
LimitCORE=0
UMask=0077
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @swap @reboot @module
# openat2 gehört zu @file-system und bleibt damit erlaubt; ein zusätzliches
# Verbot hier würde den Broker um seine einzige TOCTOU-freie Auflösung
# bringen.

# --- Fremde Schluessel aus der Umgebung des Benutzermanagers ---------------
# PFLASTER, kein Entwurf. Die Liste ist per Konstruktion ENGER als das
# Suchmuster des Waechters (KEY|TOKEN|SECRET|ANTHROPIC) und kann es nie
# einholen: sie faengt nur Namen, die jemand aufgeschrieben hat. Wer morgen
# einen Schluessel anders nennt, kommt durch. Die Erlaubnislisten-Frage --
# Umgebung leeren und nur das Gebrauchte zurueckgeben -- ist offen und wird
# getrennt entschieden.
#
# Dritte Auflage desselben Befundes, nicht die zweite: 14.08. (T-6.9,
# ELEVENLABS/MISTRAL im Mind), 29.08. (NVIDIA, FROZEN-HALTE.md: "Befund am
# Betrieb, kein Pruefstandsfehler"), 01.09. (NVIDIA/OPENROUTER in Mind und
# Plan). Zweimal war die Liste da und die zwei neuen Namen fehlten darin.
#
# Wortgleich in JEDER Unit unter config/systemd/, auch in denen ohne Netz:
# ein Kindprozess erbt die Umgebung erneut, und /proc/<pid>/environ liest
# jeder Prozess desselben Benutzers. Systemd kennt keine gemeinsame Fassung
# ohne Drop-in ausserhalb des Repos; deckungsgleich haelt die Kopien
# tests/test_umgebungswaechter.py -- derselbe Waechter misst die laufenden
# Prozesse, und ein nicht laufender Dienst ist bei ihm kein stiller Skip.
UnsetEnvironment=ANTHROPIC_API_KEY ELEVENLABS_API_KEY MISTRAL_API_KEY
UnsetEnvironment=OPENAI_API_KEY GEMINI_API_KEY GOOGLE_API_KEY HF_TOKEN
UnsetEnvironment=GITHUB_TOKEN GH_TOKEN AWS_SECRET_ACCESS_KEY
UnsetEnvironment=NVIDIA_API_KEY OPENROUTER_API_KEY

[Install]
WantedBy=graphical-session.target
