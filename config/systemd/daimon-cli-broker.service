# dAImon CLI-Broker (T-3.11b): das Abo statt des API-Keys.
#
# DIESE UNIT IST DIE SCHWAECHSTE IM PROJEKT, und das steht hier oben, damit es
# niemand uebersieht. Sie startet `claude` -- einen vollstaendigen Agenten mit
# eigenem Netz, eigener Konfiguration und eigenem Werkzeugsystem. Was der
# Egress durch Haertung zusagt (ein Ziel, kein Proxy, kein Inhalt im Prozess),
# kann diese Unit nicht zusagen.
#
# Was sie stattdessen tut:
#   * Werkzeuge werden auf der KOMMANDOZEILE abgeschaltet (--allowed-tools "").
#     Das ist eine Zusage des Aufrufs, nicht des Kernels -- und der Pruefstand
#     misst die Kommandozeile, nicht die Absicht.
#   * Ticketpflicht wie beim Egress. Ohne Kontingent kein Aufruf.
#   * Kein Inhalt im Protokoll, obwohl der Prozess ihn kennt.
#
# Wer die Opazitaet zurueck will, nimmt den Egress mit einem API-Key.
#
# Installation: systemctl --user link <dieser Pfad>
#               systemctl --user enable --now daimon-cli-broker.service
# Danach zeigt daimon-mind.service auf cli.sock statt egress.sock.

[Unit]
Description=dAImon CLI-Broker (claude -p, Abo statt API-Key)
Wants=daimon-hub.service
After=daimon-hub.service
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/itiger013/Dokumente/Github/dAImon
ExecStart=/home/itiger013/Dokumente/Github/dAImon/.venv/bin/python \
    -m daimon.brokers.cli.broker

Restart=on-failure
RestartSec=2

# --- Haertung, soweit ein Agent sie zulaesst ------------------------------
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
# `ProtectHome=tmpfs` war der erste Entwurf und hat den Dienst nicht starten
# lassen: es versteckt das GANZE Heimatverzeichnis, und darin liegt das Repo
# samt .venv -- `203/EXEC, Unable to locate executable`. Am 09.08. gemessen.
# Also read-only wie bei den anderen Units, plus genau die zwei Pfade, die die
# CLI zum Schreiben braucht.
ProtectHome=read-only
RuntimeDirectory=daimon
RuntimeDirectoryPreserve=yes
ReadWritePaths=%t/daimon %h/.claude %h/.cache/claude-cli-nodejs
# Die Schluesselbunde bleiben unerreichbar, auch fuer einen Agenten.
InaccessiblePaths=-%h/.ssh -%h/.gnupg -%h/.local/share/keyrings -%h/.pki
# Der API-Token des Egress geht diesen Prozess nichts an: er hat sein eigenes
# Anmeldeverfahren, und zwei Wege zum selben Ziel sind einer zu viel.
InaccessiblePaths=-%h/.config/daimon/anthropic-token
PrivateTmp=yes
LimitCORE=0
UMask=0077
TimeoutStopSec=15
# Design 7.5, Grundzeile fuer alle Units ausser egress (Befund T-4.14 K1).
# OHNE `@resources`: node heftet Threads an Kerne (sched_setaffinity) --
# gesperrt stuerbe der Prozess beim Start, dieselbe Klasse Problem wie beim
# GPU-Worker mit CUDA. Die uebrigen sechs Gruppen gelten trotzdem.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @obsolete @mount @swap @reboot @module

# --- Was hier ABSICHTLICH FEHLT ------------------------------------------
# Kein RestrictAddressFamilies=AF_UNIX: die CLI MUSS ins Netz. Das ist der
#   Kern des Tauschs -- neben dem Egress gibt es jetzt einen zweiten Prozess
#   mit Netzzugang, und die Zusage "genau eine Unit hat Netz" gilt nur noch,
#   solange diese Unit nicht laeuft.
# Kein MemoryDenyWriteExecute: node braucht seinen JIT. Gemessen beim
#   Ohren-Dienst, dieselbe Klasse Problem wie dort mit cffi.
# Kein SystemCallFilter=~@resources: node heftet Threads an Kerne (siehe oben).

# --- Fremde Schluessel aus der Umgebung des Benutzermanagers ---------------
# PFLASTER, kein Entwurf. Die Liste ist per Konstruktion ENGER als das
# Suchmuster des Waechters (KEY|TOKEN|SECRET|ANTHROPIC) und kann es nie
# einholen: sie faengt nur Namen, die jemand aufgeschrieben hat. Wer morgen
# einen Schluessel anders nennt, kommt durch. Die Erlaubnislisten-Frage --
# Umgebung leeren und nur das Gebrauchte zurueckgeben -- ist offen und wird
# getrennt entschieden.
#
# Dritte Auflage desselben Befundes, nicht die zweite: 14.08. (T-6.9,
# ELEVENLABS/MISTRAL im Mind), 29.08. (NVIDIA, FROZEN-HALTE.md: "Befund am
# Betrieb, kein Pruefstandsfehler"), 01.09. (NVIDIA/OPENROUTER in Mind und
# Plan). Zweimal war die Liste da und die zwei neuen Namen fehlten darin.
#
# Wortgleich in JEDER Unit unter config/systemd/, auch in denen ohne Netz:
# ein Kindprozess erbt die Umgebung erneut, und /proc/<pid>/environ liest
# jeder Prozess desselben Benutzers. Systemd kennt keine gemeinsame Fassung
# ohne Drop-in ausserhalb des Repos; deckungsgleich haelt die Kopien
# tests/test_umgebungswaechter.py -- derselbe Waechter misst die laufenden
# Prozesse, und ein nicht laufender Dienst ist bei ihm kein stiller Skip.
UnsetEnvironment=ANTHROPIC_API_KEY ELEVENLABS_API_KEY MISTRAL_API_KEY
UnsetEnvironment=OPENAI_API_KEY GEMINI_API_KEY GOOGLE_API_KEY HF_TOKEN
UnsetEnvironment=GITHUB_TOKEN GH_TOKEN AWS_SECRET_ACCESS_KEY
UnsetEnvironment=NVIDIA_API_KEY OPENROUTER_API_KEY

[Install]
WantedBy=graphical-session.target
