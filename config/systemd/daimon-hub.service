# dAImon Hub (T-0.14): Unix-Socket-Bus und gemeinsamer Sitzungszustand.
#
# Haertung nach Design 7.5 (Basis + Zeile "hub"). Jede Direktive ist
# begruendet, damit eine spaetere "Vereinfachung" sichtbar wird, welche
# Schutzschicht sie abtraegt.
#
# Installation: systemctl --user link <dieser Pfad>; systemctl --user start daimon-hub

[Unit]
Description=dAImon Hub (Unix-Socket-Bus und Sitzungszustand)
# KEIN After=graphical-session.target -- die Zeile stand hier bis zum 25.08.
# und hat in jedem Boot sechs Startauftraege gekostet (gemessen: dbus, plan,
# ears, eyes, mind, fs). Der Grund ist eine Regel aus systemd.target(5):
# ein Target ergaenzt seine Wants= selbsttaetig um After=, ABER nur bei
# Units, die sich nicht schon selbst dazu geordnet haben. Der Hub tat genau
# das -- also blieb er aus der After=-Liste des Targets heraus, waehrend die
# sechs anderen hineinkamen. Damit lief die Ordnung im Kreis:
#   daimon-dbus -> daimon-hub -> graphical-session.target -> daimon-dbus
# und systemd loeste ihn, indem es die abhaengige Unit fallen liess.
# Der Hub braucht die grafische Sitzung nicht: er vermittelt einen
# Unix-Socket und haelt Zustand, er fasst kein Wayland an. Ohne die Zeile
# zieht ihn das Target wie die uebrigen Units -- vor sich selbst, nicht
# dahinter.
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/itiger013/Dokumente/Github/dAImon

# WICHTIG: Projekt-venv, nicht System-Python. Der Hub soll exakt mit den
# im Projekt festgeschriebenen Python-Abhaengigkeiten laufen.
ExecStart=/home/itiger013/Dokumente/Github/dAImon/.venv/bin/python \
    -m daimon.hub.daemon --runtime-dir %t/daimon
Restart=on-failure
RestartSec=2

# Kein Erwerb neuer Privilegien; der Hub vermittelt Zustand, fuehrt aber
# keine privilegierten Aktionen aus.
NoNewPrivileges=yes
CapabilityBoundingSet=
# Systemverzeichnisse sind nur lesbar. Home bleibt lesbar, damit die
# Konfiguration unter ~/.config/daimon geladen werden kann.
ProtectSystem=strict
ProtectHome=read-only
# Der Hub erzeugt seine Unix-Sockets im Runtime-tmpfs und persistente
# Ticket-/Auditdaten ausschliesslich unter $XDG_STATE_HOME/daimon. Auf
# dieser Installation ist das der XDG-Standardpfad ~/.local/state/daimon.
# %t/daimon muss EXISTIEREN, bevor systemd den Namespace baut -- sonst
# stirbt die Unit mit 226/NAMESPACE, und zwar nach JEDEM Neustart, weil
# /run/user/<uid> leer hochkommt. Real passiert am 02.08.: alle vier Units
# im Restart-Karussell, Zaehler bei 97, und niemand hat es gemerkt, weil
# ein totes Pet genauso aussieht wie ein ruhiges.
# Preserve=yes, weil sonst das Stoppen EINER Unit das Verzeichnis loescht
# und den anderen drei die Sockets unter den Fuessen wegzieht.
RuntimeDirectory=daimon
RuntimeDirectoryPreserve=yes
ReadWritePaths=%t/daimon %h/.local/state/daimon
InaccessiblePaths=-%h/.ssh -%h/.gnupg -%h/.local/share/keyrings -%h/.pki
# Fremde Prozesse und Nicht-PID-Teile von /proc sind fuer den Hub unsichtbar.
# Keine gemeinsam sichtbaren Temp-Dateien und keine Core-Dumps.
PrivateTmp=yes
LimitCORE=0
# Sockets, Tickets und Auditdateien duerfen nie durch die Standard-umask
# versehentlich gruppen- oder weltlesbar entstehen.
UMask=0077
# Der Hub spricht ausschliesslich ueber Unix-Sockets. AF_INET/AF_INET6
# fehlen absichtlich; AF_UNIX muss fuer IPC und Peer-Credentials enthalten
# bleiben.
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @swap @reboot @module

# --- Fremde Schluessel aus der Umgebung des Benutzermanagers ---------------
# PFLASTER, kein Entwurf. Die Liste ist per Konstruktion ENGER als das
# Suchmuster des Waechters (KEY|TOKEN|SECRET|ANTHROPIC) und kann es nie
# einholen: sie faengt nur Namen, die jemand aufgeschrieben hat. Wer morgen
# einen Schluessel anders nennt, kommt durch. Die Erlaubnislisten-Frage --
# Umgebung leeren und nur das Gebrauchte zurueckgeben -- ist offen und wird
# getrennt entschieden.
#
# Dritte Auflage desselben Befundes, nicht die zweite: 14.08. (T-6.9,
# ELEVENLABS/MISTRAL im Mind), 29.08. (NVIDIA, FROZEN-HALTE.md: "Befund am
# Betrieb, kein Pruefstandsfehler"), 01.09. (NVIDIA/OPENROUTER in Mind und
# Plan). Zweimal war die Liste da und die zwei neuen Namen fehlten darin.
#
# Wortgleich in JEDER Unit unter config/systemd/, auch in denen ohne Netz:
# ein Kindprozess erbt die Umgebung erneut, und /proc/<pid>/environ liest
# jeder Prozess desselben Benutzers. Systemd kennt keine gemeinsame Fassung
# ohne Drop-in ausserhalb des Repos; deckungsgleich haelt die Kopien
# tests/test_umgebungswaechter.py -- derselbe Waechter misst die laufenden
# Prozesse, und ein nicht laufender Dienst ist bei ihm kein stiller Skip.
UnsetEnvironment=ANTHROPIC_API_KEY ELEVENLABS_API_KEY MISTRAL_API_KEY
UnsetEnvironment=OPENAI_API_KEY GEMINI_API_KEY GOOGLE_API_KEY HF_TOKEN
UnsetEnvironment=GITHUB_TOKEN GH_TOKEN AWS_SECRET_ACCESS_KEY
UnsetEnvironment=NVIDIA_API_KEY OPENROUTER_API_KEY

[Install]
WantedBy=graphical-session.target
