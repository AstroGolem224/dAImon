# dAImon Auth-Agent (T-1.7): GTK4-Bestaetigungsdialog und Push-to-Talk.
#
# Haertung nach Design 7.5 (Basis + Zeile "auth": ProtectHome=read-only,
# kein Netz, kein Modellkanal). Jede Direktive ist begruendet, damit eine
# spaetere "Vereinfachung" sichtbar wird, welche Schutzschicht sie abtraegt.
#
# Installation: systemctl --user link <dieser Pfad>; systemctl --user start daimon-auth

[Unit]
Description=dAImon Auth-Agent (Bestaetigungsdialoge, Push-to-Talk)
# Der Agent zeigt Fenster und braucht DBus/Wayland der Sitzung.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple

# WICHTIG: System-Python, NICHT das Projekt-venv. PyGObject (gi) ist eine
# kompilierte Erweiterung und liegt nur im System-Python 3.14; das venv ist
# auf 3.12 festgenagelt (T-1.2) und kann gi nicht importieren. Wer hier den
# venv-Pfad "repariert", bekommt einen Agenten, der beim Start stirbt --
# das ist der Grund fuer den absoluten System-Pfad.
ExecStart=/usr/bin/python3 %h/Dokumente/Github/dAImon/daimon/auth/agent.py \
    --hub-socket %t/daimon/auth.sock \
    --diag-socket %t/daimon/auth-diag.sock \
    --control-socket %t/daimon/auth-control.sock

# Produktivbetrieb: der DAIMON_MAX_SECS-Watchdog (Notbremse fuer manuelle
# Laeufe, Vorgabe 90 s) ist hier aus -- systemd uebernimmt mit Restart.
Environment=DAIMON_MAX_SECS=0
Restart=on-failure
RestartSec=2

# Kein neue Privilegien erwerben: der Agent bestaetigt Aktionen, er fuehrt
# sie nicht aus.
NoNewPrivileges=yes
# Leere Capability-Menge: Unix-Sockets, DBus und Wayland brauchen keine.
CapabilityBoundingSet=
# Systemverzeichnisse nur lesen; geschrieben wird ausschliesslich in das
# Runtime-Verzeichnis unten.
ProtectSystem=strict
# Die drei Sockets (Hub-Anbindung, Diagnose, Steuerung) liegen hier.
# %t/daimon muss EXISTIEREN, bevor systemd den Namespace baut -- sonst
# stirbt die Unit mit 226/NAMESPACE, und zwar nach JEDEM Neustart, weil
# /run/user/<uid> leer hochkommt. Real passiert am 02.08.: alle vier Units
# im Restart-Karussell, Zaehler bei 97, und niemand hat es gemerkt, weil
# ein totes Pet genauso aussieht wie ein ruhiges.
# Preserve=yes, weil sonst das Stoppen EINER Unit das Verzeichnis loescht
# und den anderen drei die Sockets unter den Fuessen wegzieht.
RuntimeDirectory=daimon
RuntimeDirectoryPreserve=yes
ReadWritePaths=%t/daimon
# Home nur lesen (Design 7.5, Zeile "auth"): ~/.config bleibt lesbar, aber
# nichts im Home wird beschrieben. Schluesselmaterial ist zusaetzlich ganz
# unsichtbar.
ProtectHome=read-only
# Der `-`-Praefix heisst "ueberspringen, wenn es den Pfad nicht gibt". Ohne ihn
# startet die Unit NICHT, sobald eines der vier Verzeichnisse fehlt:
#
#   Failed to set up mount namespacing: /home/itiger013/.gnupg: No such file
#   Failed at step NAMESPACE spawning /usr/bin/python3
#   status=226/NAMESPACE
#
# Am 09.08. beim ersten Start unter systemd gemessen (acht Neustarts) -- auf
# dieser Maschine gibt es kein ~/.gnupg. Die Haertung verliert dadurch nichts:
# ein Pfad, den es nicht gibt, ist nicht erreichbar. Alle zwoelf anderen Units
# des Projekts tragen den Praefix; diese hier war die Ausnahme.
InaccessiblePaths=-%h/.ssh -%h/.gnupg -%h/.local/share/keyrings -%h/.pki
# Kein Mitsehen auf fremde Prozesse; /proc nur die eigene Sicht.
# Eigenes /tmp: ein Bestaetigungsdialog hat keinen Grund, fremde
# Temp-Dateien zu sehen.
PrivateTmp=yes
# Nur Unix-Sockets: DBus, Wayland und die dAImon-Sockets laufen alle
# darueber. Internet-Protokollfamilien (IPv4/IPv6) sind nicht dabei --
# fehlt hier AF_UNIX, sterben DBus UND Wayland (Design 7.5).
RestrictAddressFamilies=AF_UNIX
# Üblicher Dienst-Umfang, ohne privilegierte und veraltete Aufrufe.
SystemCallFilter=@system-service
# `@resources` fehlt hier ABSICHTLICH in der Sperrliste, dieselbe Ausnahme
# wie bei `daimon-eyes`/`daimon-ears`/`daimon-recorder`/`daimon-stt`/
# `daimon-tts`: `_ohren_abschalten` ruft `daimon.ears.killswitch.stoppe`,
# das `pw-dump` als Kindprozess startet und dabei den Seccomp-Filter dieser
# Unit erbt. Live gemessen (T-5.10.v Lauf 3, 24.08.): `pw-dump` stirbt an
# SIGSYS, `aufnahmestroeme()` liefert `None` statt einer Zahl -- der
# Kill-Switch-Beleg selbst wird unmessbar. Design 7.5 fehlte dieser Dienst
# bislang in der Ausnahmetabelle -- nachgetragen.
SystemCallFilter=~@privileged @obsolete @mount @swap @reboot @module

# --- Fremde Schluessel aus der Umgebung des Benutzermanagers ---------------
# PFLASTER, kein Entwurf. Die Liste ist per Konstruktion ENGER als das
# Suchmuster des Waechters (KEY|TOKEN|SECRET|ANTHROPIC) und kann es nie
# einholen: sie faengt nur Namen, die jemand aufgeschrieben hat. Wer morgen
# einen Schluessel anders nennt, kommt durch. Die Erlaubnislisten-Frage --
# Umgebung leeren und nur das Gebrauchte zurueckgeben -- ist offen und wird
# getrennt entschieden.
#
# Dritte Auflage desselben Befundes, nicht die zweite: 14.08. (T-6.9,
# ELEVENLABS/MISTRAL im Mind), 29.08. (NVIDIA, FROZEN-HALTE.md: "Befund am
# Betrieb, kein Pruefstandsfehler"), 01.09. (NVIDIA/OPENROUTER in Mind und
# Plan). Zweimal war die Liste da und die zwei neuen Namen fehlten darin.
#
# Wortgleich in JEDER Unit unter config/systemd/, auch in denen ohne Netz:
# ein Kindprozess erbt die Umgebung erneut, und /proc/<pid>/environ liest
# jeder Prozess desselben Benutzers. Systemd kennt keine gemeinsame Fassung
# ohne Drop-in ausserhalb des Repos; deckungsgleich haelt die Kopien
# tests/test_umgebungswaechter.py -- derselbe Waechter misst die laufenden
# Prozesse, und ein nicht laufender Dienst ist bei ihm kein stiller Skip.
UnsetEnvironment=ANTHROPIC_API_KEY ELEVENLABS_API_KEY MISTRAL_API_KEY
UnsetEnvironment=OPENAI_API_KEY GEMINI_API_KEY GOOGLE_API_KEY HF_TOKEN
UnsetEnvironment=GITHUB_TOKEN GH_TOKEN AWS_SECRET_ACCESS_KEY
UnsetEnvironment=NVIDIA_API_KEY OPENROUTER_API_KEY

[Install]
WantedBy=graphical-session.target
