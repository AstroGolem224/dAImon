# dAImon Hook-Bridge (T-0.14): eng begrenztes HTTP-zu-Unix-Socket-Gateway.
#
# Sie ist absichtlich ein eigener Prozess: nur die Bridge braucht AF_INET.
# Der Hub behaelt dadurch seine harte AF_UNIX-Grenze.
#
# Installation: systemctl --user link <dieser Pfad>; systemctl --user start daimon-hookbridge

[Unit]
Description=dAImon Hook-Bridge (Loopback-HTTP zu Hub-Unix-Socket)
After=graphical-session.target daimon-hub.service
Wants=daimon-hub.service
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/itiger013/Dokumente/Github/dAImon

# WICHTIG: Projekt-venv, nicht System-Python. Bridge und Hub teilen das
# festgeschriebene Python-Protokoll und dieselbe Projektumgebung.
ExecStart=/home/itiger013/Dokumente/Github/dAImon/.venv/bin/python \
    -m daimon.hookbridge.daemon \
    --runtime-dir %t/daimon \
    --host 127.0.0.1 \
    --port 8787 \
    --audit-log %h/.local/state/daimon/audit/hookbridge.log
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=read-only
# Token und Hub-Socket liegen im Runtime-Verzeichnis; abgewiesene Hook-
# Aufrufe werden zusaetzlich zum Journal im Audit-Verzeichnis protokolliert.
# %t/daimon muss EXISTIEREN, bevor systemd den Namespace baut -- sonst
# stirbt die Unit mit 226/NAMESPACE, und zwar nach JEDEM Neustart, weil
# /run/user/<uid> leer hochkommt. Real passiert am 02.08.: alle vier Units
# im Restart-Karussell, Zaehler bei 97, und niemand hat es gemerkt, weil
# ein totes Pet genauso aussieht wie ein ruhiges.
# Preserve=yes, weil sonst das Stoppen EINER Unit das Verzeichnis loescht
# und den anderen drei die Sockets unter den Fuessen wegzieht.
RuntimeDirectory=daimon
RuntimeDirectoryPreserve=yes
ReadWritePaths=%t/daimon %h/.local/state/daimon/audit
InaccessiblePaths=-%h/.ssh -%h/.gnupg -%h/.local/share/keyrings -%h/.pki
PrivateTmp=yes
LimitCORE=0
# Insbesondere hook-token und Auditdatei muessen als 0600 entstehen.
UMask=0077
# AF_INET ist die dokumentierte Abweichung fuer den Loopback-Listener.
# AF_UNIX bleibt fuer die Weiterleitung zum Hub notwendig.
RestrictAddressFamilies=AF_UNIX AF_INET
# Selbst innerhalb AF_INET darf die Bridge nur Loopback-Verkehr sehen.
IPAddressDeny=any
IPAddressAllow=localhost
# Gebunden werden darf nur der festgelegte IPv4/TCP-Port.
SocketBindDeny=any
SocketBindAllow=ipv4:tcp:8787
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @swap @reboot @module

# --- Fremde Schluessel aus der Umgebung des Benutzermanagers ---------------
# PFLASTER, kein Entwurf. Die Liste ist per Konstruktion ENGER als das
# Suchmuster des Waechters (KEY|TOKEN|SECRET|ANTHROPIC) und kann es nie
# einholen: sie faengt nur Namen, die jemand aufgeschrieben hat. Wer morgen
# einen Schluessel anders nennt, kommt durch. Die Erlaubnislisten-Frage --
# Umgebung leeren und nur das Gebrauchte zurueckgeben -- ist offen und wird
# getrennt entschieden.
#
# Dritte Auflage desselben Befundes, nicht die zweite: 14.08. (T-6.9,
# ELEVENLABS/MISTRAL im Mind), 29.08. (NVIDIA, FROZEN-HALTE.md: "Befund am
# Betrieb, kein Pruefstandsfehler"), 01.09. (NVIDIA/OPENROUTER in Mind und
# Plan). Zweimal war die Liste da und die zwei neuen Namen fehlten darin.
#
# Wortgleich in JEDER Unit unter config/systemd/, auch in denen ohne Netz:
# ein Kindprozess erbt die Umgebung erneut, und /proc/<pid>/environ liest
# jeder Prozess desselben Benutzers. Systemd kennt keine gemeinsame Fassung
# ohne Drop-in ausserhalb des Repos; deckungsgleich haelt die Kopien
# tests/test_umgebungswaechter.py -- derselbe Waechter misst die laufenden
# Prozesse, und ein nicht laufender Dienst ist bei ihm kein stiller Skip.
UnsetEnvironment=ANTHROPIC_API_KEY ELEVENLABS_API_KEY MISTRAL_API_KEY
UnsetEnvironment=OPENAI_API_KEY GEMINI_API_KEY GOOGLE_API_KEY HF_TOKEN
UnsetEnvironment=GITHUB_TOKEN GH_TOKEN AWS_SECRET_ACCESS_KEY
UnsetEnvironment=NVIDIA_API_KEY OPENROUTER_API_KEY

[Install]
WantedBy=graphical-session.target
