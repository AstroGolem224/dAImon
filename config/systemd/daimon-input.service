[Unit]
# T-4.13 — der Input-Broker. Eine Ereignisfolge, dann Ende.
Description=dAImon Input-Broker (one-shot, libei über RemoteDesktop)
PartOf=graphical-session.target
After=daimon-hub.service

[Service]
Type=oneshot
WorkingDirectory=/home/itiger013/Dokumente/Github/dAImon
ExecStart=/home/itiger013/Dokumente/Github/dAImon/.venv/bin/python \
    -m daimon.brokers.input.daemon \
    --socket %t/daimon/input-broker.sock \
    --katalog /home/itiger013/Dokumente/Github/dAImon/config/actions/core.yaml

# Das Zwangsende. Der Broker beendet sich selbst nach seiner einen Folge --
# diese Zeile ist für den Fall, dass er es nicht schafft. Ein Prozess, der
# Tastenanschläge synthetisieren kann, darf nicht dauerhaft leben, auch nicht
# durch einen Fehler.
RuntimeMaxSec=30
# KEIN Restart. Ein neu gestarteter Input-Broker wäre ein dauerhafter.
Restart=no

NoNewPrivileges=yes
# Design 7.5, Grundzeile fuer alle Units ausser egress (Befund T-4.14 K1).
CapabilityBoundingSet=
# Die EINE Ausnahme im ganzen Katalog (Design 7.5). `PrivateDevices=yes`
# wuerde /dev/uinput mit ausblenden -- dann staende das DeviceAllow daneben
# und gaelte nicht, und das waere die schlimmere Fassung: eine Regel, die
# sich gut liest und nichts tut. Keine andere Unit traegt diese beiden
# Zeilen (Befund T-4.13 K9).
PrivateDevices=no
DeviceAllow=/dev/uinput rw
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ProtectHome=tmpfs
RuntimeDirectory=daimon
RuntimeDirectoryPreserve=yes
ReadWritePaths=%t/daimon
InaccessiblePaths=-%h/.ssh -%h/.gnupg -%h/.local/share/keyrings -%h/.pki
PrivateTmp=yes
LimitCORE=0
UMask=0077
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @swap @reboot @module

# ydotool ist NICHT eingeschaltet. Es verlangt einen dauerhaften
# privilegierten ydotoold und widerspricht damit der One-shot-Zusage; und es
# positioniert auf dieser Maschine nachweislich nicht (Spike T−1.3: absolute
# Bewegung landet bei (0,0), Exit 0, keine Meldung). Wer es trotzdem will,
# setzt hier DAIMON_YDOTOOL=1 -- und bekommt eine ungenaue relative Bewegung.
Environment=DAIMON_YDOTOOL=0

# --- Fremde Schluessel aus der Umgebung des Benutzermanagers ---------------
# PFLASTER, kein Entwurf. Die Liste ist per Konstruktion ENGER als das
# Suchmuster des Waechters (KEY|TOKEN|SECRET|ANTHROPIC) und kann es nie
# einholen: sie faengt nur Namen, die jemand aufgeschrieben hat. Wer morgen
# einen Schluessel anders nennt, kommt durch. Die Erlaubnislisten-Frage --
# Umgebung leeren und nur das Gebrauchte zurueckgeben -- ist offen und wird
# getrennt entschieden.
#
# Dritte Auflage desselben Befundes, nicht die zweite: 14.08. (T-6.9,
# ELEVENLABS/MISTRAL im Mind), 29.08. (NVIDIA, FROZEN-HALTE.md: "Befund am
# Betrieb, kein Pruefstandsfehler"), 01.09. (NVIDIA/OPENROUTER in Mind und
# Plan). Zweimal war die Liste da und die zwei neuen Namen fehlten darin.
#
# Wortgleich in JEDER Unit unter config/systemd/, auch in denen ohne Netz:
# ein Kindprozess erbt die Umgebung erneut, und /proc/<pid>/environ liest
# jeder Prozess desselben Benutzers. Systemd kennt keine gemeinsame Fassung
# ohne Drop-in ausserhalb des Repos; deckungsgleich haelt die Kopien
# tests/test_umgebungswaechter.py -- derselbe Waechter misst die laufenden
# Prozesse, und ein nicht laufender Dienst ist bei ihm kein stiller Skip.
UnsetEnvironment=ANTHROPIC_API_KEY ELEVENLABS_API_KEY MISTRAL_API_KEY
UnsetEnvironment=OPENAI_API_KEY GEMINI_API_KEY GOOGLE_API_KEY HF_TOKEN
UnsetEnvironment=GITHUB_TOKEN GH_TOKEN AWS_SECRET_ACCESS_KEY
UnsetEnvironment=NVIDIA_API_KEY OPENROUTER_API_KEY

[Install]
WantedBy=graphical-session.target
