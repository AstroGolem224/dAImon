# dAImon STT (T-3.8): Audio rein, Text raus. sherpa-onnx auf der CPU, 0 VRAM.
#
# Socket-aktiviert, aber OHNE Leerlauf-Exit -- der Unterschied zum GPU-Worker aus
# T-3.7 und derselbe Grund wie beim TTS: dort war die belastbare Groesse die
# VRAM-Rueckgabe nach dem Prozessende, hier gibt es kein VRAM, und ein Neustart
# kostet 843 ms Ladezeit. Das Modell im Speicher IST die Latenzzusage
# (gemessen: Median 117 ms je Aeusserung, p95 152 ms).
#
# Haertung nach Design 7.5. Jede Direktive ist begruendet, damit eine spaetere
# "Vereinfachung" sichtbar macht, welche Schicht sie abtraegt.
#
# Installation: systemctl --user link <dieser Pfad>
#               systemctl --user enable --now daimon-stt.socket

[Unit]
Description=dAImon STT (sherpa-onnx parakeet-tdt-0.6b-v3, CPU)
# Ohne den Socket gibt es keinen Deskriptor zum Erben. Requires statt Wants:
# ein Dienst ohne Socket waere gestartet und unerreichbar.
Requires=daimon-stt.socket
After=daimon-stt.socket
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/itiger013/Dokumente/Github/dAImon

# Projekt-venv: sherpa-onnx liegt dort. System-Python ist 3.14 ohne das Paket --
# dieselbe Zwei-Interpreter-Trennung wie beim Auth-Agenten, nur umgekehrt.
ExecStart=/home/itiger013/Dokumente/Github/dAImon/.venv/bin/python \
    -m daimon.gpu.stt

# Restart=on-failure, nicht `no`: ein Ende ist hier immer ein Fehler, dieser
# Dienst hat keinen geordneten Ausgang. Ohne Restart waere das Pet nach einem
# Absturz dauerhaft taub, und taub sieht aus wie "hoert nicht zu".
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
# Read-only genuegt: die Gewichte werden GELESEN. Der Dienst schreibt nichts --
# kein Zustand, keine Abkuehlung, kein Zwischenspeicher.
ProtectHome=read-only
RuntimeDirectory=daimon
RuntimeDirectoryPreserve=yes
ReadWritePaths=%t/daimon
InaccessiblePaths=-%h/.ssh -%h/.gnupg -%h/.local/share/keyrings -%h/.pki
# Dieser Dienst sieht ALLES, was ins Mikrofon gesprochen wurde. Fremde Prozesse
# und die Nicht-PID-Teile von /proc gehen ihn nichts an.
PrivateTmp=yes
# Keine Core-Dumps: ein Dump enthielte den Audiopuffer und den Text.
LimitCORE=0
UMask=0077
# Der Dienst spricht ausschliesslich ueber seinen Unix-Socket. Er laedt NICHTS
# herunter: fehlen die Gewichte, kommt `modell_fehlt` -- ein Modell, das beim
# ersten Wort aus dem Netz kaeme, waere eine Latenz, die niemand messen kann,
# und ein Mikrofondienst mit Netzzugang ist ohnehin die falsche Kombination.
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
# @resources ist NICHT gefiltert, und das ist gemessen: mit `~@resources` laedt
# das Modell noch (die Zeile "Modell geladen" steht im Journal), und der Prozess
# stirbt dann mit `status=31/SYS`. onnxruntime heftet seine Rechenthreads an
# Kerne (sched_setaffinity/sched_setattr liegen in @resources). "Laedt" ist hier
# also kein Beweis fuer "laeuft" -- derselbe Fall wie beim TTS, dort war es der
# PipeWire-Client.
SystemCallFilter=~@privileged @obsolete @mount @swap @reboot @module
# W+X wird nicht gebraucht: onnxruntime auf der CPU, kein JIT-Provider. Beim
# GPU-Worker fehlt diese Direktive, weil der CUDA-JIT sie braucht -- hier ist
# sie deshalb setzbar, und das ist der Gewinn des CPU-Pfads.
MemoryDenyWriteExecute=yes
# Kein Geraeteknoten: kein /dev/nvidia*, kein /dev/snd. Der Dienst bekommt eine
# DATEI und gibt Text; das Mikrofon gehoert dem Ohren-Dienst.
PrivateDevices=yes
TimeoutStopSec=10

# --- Was hier ABSICHTLICH FEHLT ------------------------------------------
# Kein `[Install]`: gestartet wird ausschliesslich ueber den Socket. Ein
#   `enable` waere ein Modell, das beim Anmelden 843 ms und rund 700 MB kostet,
#   ohne dass jemand etwas gesagt hat.
# Kein `Nice=`/`CPUWeight=`, obwohl der Dienst acht Threads nimmt: ein
#   herabgesetzter Erkenner ist bei Last genau dann langsam, wenn die Antwort
#   gebraucht wird. Wer die Kerne braucht, senkt `stt.threads` -- das ist der
#   Kalibrierknopf, nicht die Scheduler-Prioritaet.
# Kein `MemoryMax=`: der Encoder ist 652 MB int8, und ein zu knappes Limit
#   erzeugt einen OOM-Kill mitten in einer Aeusserung. Wer hier eine Grenze
#   setzt, messe vorher den Spitzenverbrauch.

# --- Fremde Schluessel aus der Umgebung des Benutzermanagers ---------------
# PFLASTER, kein Entwurf. Die Liste ist per Konstruktion ENGER als das
# Suchmuster des Waechters (KEY|TOKEN|SECRET|ANTHROPIC) und kann es nie
# einholen: sie faengt nur Namen, die jemand aufgeschrieben hat. Wer morgen
# einen Schluessel anders nennt, kommt durch. Die Erlaubnislisten-Frage --
# Umgebung leeren und nur das Gebrauchte zurueckgeben -- ist offen und wird
# getrennt entschieden.
#
# Dritte Auflage desselben Befundes, nicht die zweite: 14.08. (T-6.9,
# ELEVENLABS/MISTRAL im Mind), 29.08. (NVIDIA, FROZEN-HALTE.md: "Befund am
# Betrieb, kein Pruefstandsfehler"), 01.09. (NVIDIA/OPENROUTER in Mind und
# Plan). Zweimal war die Liste da und die zwei neuen Namen fehlten darin.
#
# Wortgleich in JEDER Unit unter config/systemd/, auch in denen ohne Netz:
# ein Kindprozess erbt die Umgebung erneut, und /proc/<pid>/environ liest
# jeder Prozess desselben Benutzers. Systemd kennt keine gemeinsame Fassung
# ohne Drop-in ausserhalb des Repos; deckungsgleich haelt die Kopien
# tests/test_umgebungswaechter.py -- derselbe Waechter misst die laufenden
# Prozesse, und ein nicht laufender Dienst ist bei ihm kein stiller Skip.
UnsetEnvironment=ANTHROPIC_API_KEY ELEVENLABS_API_KEY MISTRAL_API_KEY
UnsetEnvironment=OPENAI_API_KEY GEMINI_API_KEY GOOGLE_API_KEY HF_TOKEN
UnsetEnvironment=GITHUB_TOKEN GH_TOKEN AWS_SECRET_ACCESS_KEY
UnsetEnvironment=NVIDIA_API_KEY OPENROUTER_API_KEY
