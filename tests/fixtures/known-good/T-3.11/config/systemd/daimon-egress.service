# Gut-Muster T-3.11: Härtung wird am laufenden Prozess geprüft.
[Unit]
Description=dAImon Egress

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m daimon.brokers.egress
LoadCredential=anthropic-token:/dev/null
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=read-only
# T-4.14 (7b7deb9): hier standen `ProtectProc=invisible`/`ProcSubset=pid`.
# In `--user`-Units wirkungslos -- systemd.exec(5) zu `ProcSubset=`: "it is
# only available to system services". Ersetzt durch das, was wirkt: leerer
# CapabilityBoundingSet (oben) und die Sperrliste unten. Nicht zurueckschreiben.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @swap @reboot @module
PrivateTmp=yes
LimitCORE=0
UMask=0077
RuntimeDirectory=daimon
RuntimeDirectoryPreserve=yes
ReadWritePaths=%t/daimon
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY
