[Unit]
Description=dAImon-Face (Gut-Muster)
PartOf=graphical-session.target
After=daimon-hub.service
Wants=daimon-hub.service

[Service]
Type=simple
ExecStart=%h/Dokumente/Github/dAImon/face/target/debug/daimon-face
Restart=on-failure

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
# `ProtectProc=`/`ProcSubset=` stehen hier ABSICHTLICH NICHT: in einer
# `--user`-Unit sind sie wirkungslos (systemd.exec(5) zu `ProcSubset=`:
# "it is only available to system services"), und `systemctl --user show`
# meldet mit wie ohne sie `default`/`all`. Commit `7b7deb9` (T-4.14) hat sie
# aus allen 22 Units gestrichen; was in `--user` WIRKT, steht darueber und
# darunter: leerer `CapabilityBoundingSet=` und die Syscall-Sperrliste.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @swap @reboot @module
# AF_UNIX MUSS drin bleiben: ohne ihn faellt der Wayland-Socket weg, und das
# Overlay startet gar nicht erst (Design 7.5, "Direktiven, die brechen").
RestrictAddressFamilies=AF_UNIX
InaccessiblePaths=%h/.ssh %h/.gnupg %h/.local/share/keyrings %h/.pki

[Install]
WantedBy=graphical-session.target
