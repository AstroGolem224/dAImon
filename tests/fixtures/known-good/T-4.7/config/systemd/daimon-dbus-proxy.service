[Unit]
# T-4.7 (GUT-MUSTER, Reviewer) — die zweite Schicht als eigene Unit.
#
# Im Arbeitsbaum gibt es diese Unit nicht, und niemand sonst startet den
# Proxy: `config/dbus-filter.conf` ist dort eine Datei ohne Leser. Hier hat
# sie einen, und der DBus-Broker spricht ueber den Socket, den sie oeffnet.
Description=dAImon DBus-Proxy (Methodenfilter vor dem DBus-Broker)
PartOf=graphical-session.target
Before=daimon-dbus.service

[Service]
Type=simple
RuntimeDirectory=daimon
RuntimeDirectoryPreserve=yes
# `--args=FD` liest NUL-getrennte Argumente. Kommentar- und Leerzeilen aus
# config/dbus-filter.conf fallen weg, der Rest geht als Argumentliste hinein.
ExecStart=/bin/sh -c 'exec 3< <(grep -v "^[[:space:]]*\\(#\\|$$\\)" /home/itiger013/Dokumente/Github/dAImon/config/dbus-filter.conf | tr "\\n" "\\0"); exec xdg-dbus-proxy --args=3 unix:path=%%t/bus %%t/daimon/dbus-proxy.sock'
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=read-only
ProtectProc=invisible
ProcSubset=pid
PrivateDevices=yes
ReadWritePaths=%t/daimon
InaccessiblePaths=-%h/.ssh -%h/.gnupg -%h/.local/share/keyrings -%h/.pki
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @swap @reboot @module
UMask=0077

[Install]
WantedBy=graphical-session.target
