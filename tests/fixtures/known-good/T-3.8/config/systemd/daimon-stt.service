[Unit]
Description=dAImon STT-Dienst (sherpa-onnx auf der CPU)
Requires=daimon-stt.socket
After=daimon-stt.socket

[Service]
Type=simple
ExecStart=%h/Dokumente/Github/dAImon/.venv/bin/python -B -P %h/Dokumente/Github/dAImon/daimon/gpu/stt.py
Restart=on-failure
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=read-only
# `ProtectProc=`/`ProcSubset=` stehen hier ABSICHTLICH NICHT: in einer
# `--user`-Unit sind sie wirkungslos (systemd.exec(5) zu `ProcSubset=`:
# "it is only available to system services"), und `systemctl --user show`
# meldet mit wie ohne sie `default`/`all`. Commit `7b7deb9` (T-4.14) hat sie
# aus allen 22 Units gestrichen; was in `--user` WIRKT, steht darueber und
# darunter: leerer `CapabilityBoundingSet=` und die Syscall-Sperrliste.
PrivateTmp=yes
PrivateDevices=yes
MemoryDenyWriteExecute=yes
LimitCORE=0
UMask=0077
RuntimeDirectory=daimon
RuntimeDirectoryPreserve=yes
RestrictAddressFamilies=AF_UNIX
# ~@resources wird nicht gesperrt: sherpa-onnx setzt und sperrt Thread-Ressourcen.
SystemCallFilter=~@clock @cpu-emulation @debug @keyring @module @mount @obsolete @privileged @raw-io @reboot @swap
